# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI (AI Assistant uchun)
# https://aistudio.google.com/app/apikey sahifasidan bepul oling
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key

# Upstash Redis — serverless'da umumiy rate limiting uchun (ixtiyoriy;
# sozlanmasa in-memory fallback ishlaydi). https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Site URL (SEO va metadata uchun)
NEXT_PUBLIC_SITE_URL=https://devcommons.uz

# Google Search Console Verification (ixtiyoriy)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_code

# GitHub OAuth (Supabase Auth orqali sozlanadi)
# https://supabase.com/docs/guides/auth/social-login/auth-github
